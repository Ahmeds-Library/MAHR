{
  "appId": "com.mahr.ai",
  "productName": "MAHR",
  "directories": {
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*"
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "perMachine": false
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "public/icon-512.png"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "icon": "public/icon-512.png"
  }
}
