{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist_electron/main.cjs",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild electron/main.cjs --bundle --platform=node --format=cjs --packages=external --target=node20 --outfile=dist_electron/main.cjs && node scripts/create_installers.cjs",
    "build:electron": "esbuild electron/main.cjs --bundle --platform=node --format=cjs --packages=external --target=node20 --outfile=dist_electron/main.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron electron/main.cjs",
    "electron:pack": "electron-builder --dir",
    "electron:build:win": "electron-builder --win",
    "electron:build:linux": "electron-builder --linux AppImage deb",
    "electron:build:all": "electron-builder -wl"
  },
  "build": {
    "appId": "com.mahr.ai",
    "productName": "MAHR",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icon-512.png"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "bytenode": "^1.6.0",
    "cannon-es": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "perfect-freehand": "^1.2.3",
    "pg": "^8.23.0",
    "pixi.js": "^8.5.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.14",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
